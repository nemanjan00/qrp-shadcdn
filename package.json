{
	"name": "@nemanjan00/qrp-shadcdn",
	"version": "0.1.0",
	"description": "shadcn/ui components for qrp, bundled as one ESM module and served over CDN. Prebuilt CSS, no build step on your end.",
	"type": "module",
	"license": "MIT",
	"main": "./dist/qrp-shadcdn.js",
	"module": "./dist/qrp-shadcdn.js",
	"types": "./index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./dist/qrp-shadcdn.js"
		},
		"./qrp-shadcdn.css": "./dist/qrp-shadcdn.css",
		"./theme.css": "./styles/theme.css",
		"./package.json": "./package.json"
	},
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist",
		"index.d.ts",
		"components/*.d.ts",
		"utils/*.d.ts",
		"styles/theme.css",
		"README.md"
	],
	"author": "Nemanja Nedeljkovic <nemanjan00@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nemanjan00/qrp-shadcdn.git"
	},
	"keywords": [
		"qrp",
		"shadcn",
		"shadcn-ui",
		"cdn",
		"esm",
		"components",
		"dashboard",
		"tailwind"
	],
	"scripts": {
		"test": "node --test 'test/*.test.js'",
		"build": "node bin/build.js",
		"lint": "eslint index.js components utils icons bin test",
		"prepack": "node bin/build.js",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.js": "eslint --fix"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@nemanjan00/qrp": "^0.10.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@babel/eslint-parser": "^7.29.9",
		"@nemanjan00/qrp": "^0.10.0",
		"@tailwindcss/cli": "^4.3.3",
		"esbuild": "^0.28.2",
		"eslint": "^8.57.1",
		"happy-dom": "^21.0.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0"
	}
}
