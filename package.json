{
	"name": "@nemanjan00/qrp-shadcdn",
	"version": "0.3.1",
	"description": "shadcn/ui, without React — 50+ shadcn components on qrp, a 5 KB reactive core. Real DOM, no build step required; one import from a CDN, or tree-shaken from npm.",
	"type": "module",
	"license": "MIT",
	"main": "./index.js",
	"module": "./index.js",
	"types": "./index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		},
		"./qrp-shadcdn.css": "./dist/qrp-shadcdn.css",
		"./theme.css": "./styles/theme.css",
		"./package.json": "./package.json",
		"./bundle": "./dist/qrp-shadcdn.js"
	},
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"index.js",
		"index.d.ts",
		"components/*.js",
		"utils/*.js",
		"icons/*.js",
		"dist",
		"styles/theme.css",
		"README.md"
	],
	"author": "Nemanja Nedeljkovic <nemanjan00@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nemanjan00/qrp-shadcdn.git"
	},
	"keywords": [
		"qrp",
		"shadcn",
		"shadcn-ui",
		"cdn",
		"esm",
		"components",
		"dashboard",
		"tailwind",
		"without-react",
		"no-react",
		"vanilla-js"
	],
	"scripts": {
		"test": "NODE_OPTIONS=--max-old-space-size=1024 node --test --test-timeout=30000 'test/*.test.js'",
		"build": "node bin/build.js",
		"lint": "eslint index.js components utils icons bin test demo",
		"prepack": "node bin/build.js",
		"prepare": "husky",
		"build:demo": "node bin/build.js && tailwindcss -i demo/demo.css -o demo/demo.built.css.tmp && mv demo/demo.built.css.tmp demo/demo.built.css",
		"demo": "npm run build:demo && python3 -m http.server 8000",
		"typecheck": "tsc -p tsconfig.json",
		"check:types": "NODE_OPTIONS=--max-old-space-size=512 node bin/check-types.js",
		"build:site": "node bin/build-site.js"
	},
	"lint-staged": {
		"*.js": "eslint --fix"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@nemanjan00/qrp": "^0.13.1"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@babel/eslint-parser": "^7.29.9",
		"@nemanjan00/qrp": "^0.13.1",
		"@tailwindcss/cli": "^4.3.3",
		"esbuild": "^0.28.2",
		"eslint": "^8.57.1",
		"happy-dom": "^21.0.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2"
	},
	"homepage": "https://qrp-shadcdn.onrender.com/"
}
